# x . x + x over 4Mi f32 values (16 MiB each way), emitted by Tlaloc
# (./gradlew :maestro:exportTritonExamples). When the client places X and Y in
# CUDA shared memory, the backend reads X in place and copies Y device to
# device; large_io_host is the same model with that turned off.
name: "large_io"
backend: "tlaloc"
max_batch_size: 0
input [ { name: "X" data_type: TYPE_FP32 dims: [ 4194304 ] } ]
output [ { name: "Y" data_type: TYPE_FP32 dims: [ 4194304 ] } ]
instance_group [ { kind: KIND_GPU count: 1 gpus: [ 0 ] } ]
parameters: { key: "artifact" value: { string_value: "model.mlir" } }
