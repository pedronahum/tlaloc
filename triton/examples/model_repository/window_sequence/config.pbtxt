# Written by Tlaloc from the serving artifact 'window-sequence'
# (window-sequence-v1), 9 entries: decode_b1_c16, decode_b1_c32, decode_b1_c64, decode_b2_c16, decode_b2_c32, decode_b2_c64, prefill_b1_c16, prefill_b1_c32, prefill_b1_c64.
# Sequence mode: a request sends one sequence's token ids (with its correlation
# ID and START/END flags) and gets the last token's logits. The backend keeps each
# sequence's KV pages; a request of several tokens runs as a prefill chunk,
# one token as a decode step batched with other sequences' steps.
name: "window_sequence"
backend: "tlaloc"
max_batch_size: 2
input [
  { name: "TOKENS" data_type: TYPE_INT32 dims: [ -1 ] allow_ragged_batch: true }
]
output [
  { name: "LOGITS" data_type: TYPE_FP32 dims: [ 64 ] },
  { name: "KV_PAGES" data_type: TYPE_INT32 dims: [ 2 ] }
]
sequence_batching {
  max_sequence_idle_microseconds: 60000000
  control_input [
    { name: "START" control [ { kind: CONTROL_SEQUENCE_START int32_false_true: [ 0, 1 ] } ] },
    { name: "END" control [ { kind: CONTROL_SEQUENCE_END int32_false_true: [ 0, 1 ] } ] },
    { name: "CORRID" control [ { kind: CONTROL_SEQUENCE_CORRID data_type: TYPE_UINT64 } ] }
  ]
  oldest {
    max_candidate_sequences: 12
    preferred_batch_size: [ 2 ]
    max_queue_delay_microseconds: 1000
  }
}
instance_group [ { kind: KIND_GPU count: 1 gpus: [ 0 ] } ]
parameters: { key: "serving_manifest" value: { string_value: "tlaloc-serving.json" } }
parameters: { key: "kv_block_size" value: { string_value: "4" } }
parameters: { key: "kv_num_blocks" value: { string_value: "65" } }
parameters: { key: "max_context" value: { string_value: "64" } }
parameters: { key: "kv_window" value: { string_value: "8" } }
parameters: { key: "kv_window_layers" value: { string_value: "0,1" } }
parameters: { key: "kv_window_num_blocks" value: { string_value: "13" } }
parameters: { key: "kv_window_ring_pages" value: { string_value: "3" } }
