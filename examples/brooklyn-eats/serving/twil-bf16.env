# TwIL-8B bf16 as served for the agent and baseline stages. Read by serving/server.sh and recorded
# (with its SHA-256) in manifest.json. One KEY=value per line; no shell expansion.
MODEL_KEY=twil_8b
TRITON_MODEL=twil
SERVED_NAME=twil-8b
TEMPLATE=TWIL
# :maestro:exportHfServingArtifact properties. bf16 weights as stored; KV in the activations'
# dtype (f32): 320 KiB per token. 4 sequences in a batch, contexts 8,192 and 16,384, 4,352 KV
# blocks of 16 tokens (69,632 tokens, 21.3 GiB), prompts prefilled 512 tokens per call.
EXPORT_PROPS=-PweightDType=bf16 -PmaxBatch=4 -PcontextLadder=8192,16384 -PblockSize=16 -PnumBlocks=4352 -PprefillChunk=512 -PprefillMaxBatch=2 -PcudaKernels=true
# :maestro:exportTritonModel properties. cohortWaitMicros=20000 is the measured goodput choice
# (SERVING_ARCHITECTURE.md §6): at ~85 ms a decode step, waiting 20 ms for the previous batch's
# sequences coalesces cohorts — 31.7 vs 19.8 tok/s at N=4 against no wait. It equals the backend
# default; naming it pins the measured choice rather than leaving it implicit.
TRITON_PROPS=-Pdecoupled=true -PmaxSequenceIdleMicros=600000000 -PcohortWaitMicros=20000
# Share of GPU memory the PJRT client may use (KV pools and activations; weights are outside it).
MEMORY_FRACTION=0.3
# 1: XLA's deterministic ops and the CUDA kernels' order-independent sums. Off: with it a decode
# step of one sequence took 376 ms instead of 80 ms on the GB10.
DETERMINISTIC=0
# Live sequences the endpoint keeps for prefix reuse (--max-sequences). The model's 16 candidate
# sequences would keep finished conversations' KV until they idle out, and four conversations in
# flight then ran out of KV pages (HTTP 503 mid-generation); 4 is one per sequence in a batch.
ENDPOINT_MAX_SEQUENCES=4
# nvcr.io/nvidia/tritonserver:25.11-py3, pinned by digest; the backend is built in it too.
TRITON_IMAGE=nvcr.io/nvidia/tritonserver@sha256:871ef190093156e6f9b6371ac7663652e3d7d0f9b83729fe1f11af062b9fbb3b
