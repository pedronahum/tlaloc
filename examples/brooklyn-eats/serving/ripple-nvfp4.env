# Ripple-65B-Preview NVFP4 with the DFlash2 draft, as served for the baseline and teach stages.
# Read by serving/server.sh and recorded (with its SHA-256) in manifest.json. One KEY=value per line;
# no shell expansion. Settings from docs/work-log/ripple-plan.md (draft rings and W4A4 prefill),
# with the context ladder cut to the agent's 16,384 tokens.
MODEL_KEY=ripple_65b_nvfp4
# The DFlash2 draft's checkpoint (-PdraftCkptDir); it stays bf16 under the NVFP4 target.
DRAFT_KEY=ripple_65b_dflash2
TRITON_MODEL=ripple
SERVED_NAME=ripple-65b
TEMPLATE=RIPPLE
# :maestro:exportHfServingArtifact properties. NVFP4 MLP, bf16 attention as stored, FP8 KV; 15
# drafts with verify entries for 3 and 7; 4 sequences in a batch, contexts 8,192 and 16,384, 4,352
# KV blocks of 16 tokens; prefill chunks of 128 and 512 tokens with NVFP4 activations (W4A4).
EXPORT_PROPS=-PweightDType=bf16 -PweightQuant=nvfp4 -PattentionQuant=none -PkvDtype=fp8 -PcudaKernels=true -PmtpDraftTokens=15 -PmtpVerifyDrafts=3,7 -PmaxBatch=4 -PcontextLadder=8192,16384 -PblockSize=16 -PnumBlocks=4352 -PprefillChunk=128,512 -PprefillMaxBatch=2 -Psampling=true -PprefillActQuant=projections
# :maestro:exportTritonModel properties. cohortWaitMicros=20000 is the backend default, kept:
# the measured sweep (SERVING_ARCHITECTURE.md §6) found the wait barely matters for this
# speculative model (<=4% across 0..20000 us); what matters is concurrency — 2 sequences beat 4
# on goodput (12.6 vs 10.5 tok/s), since a generation runs 5-7 draft/verify executions.
TRITON_PROPS=-Pdecoupled=true -PmaxSequenceIdleMicros=600000000 -PcohortWaitMicros=20000
# Share of GPU memory the PJRT client may use (weights are outside it).
MEMORY_FRACTION=0.1
# Off, as for TwIL (see twil-bf16.env).
DETERMINISTIC=0
# Live sequences the endpoint keeps for prefix reuse (--max-sequences). The model's 16 candidate
# sequences would keep finished conversations' KV until they idle out, and four conversations in
# flight then ran out of KV pages (HTTP 503 mid-generation); 4 is one per sequence in a batch.
ENDPOINT_MAX_SEQUENCES=4
# nvcr.io/nvidia/tritonserver:25.11-py3, pinned by digest; the backend is built in it too.
TRITON_IMAGE=nvcr.io/nvidia/tritonserver@sha256:871ef190093156e6f9b6371ac7663652e3d7d0f9b83729fe1f11af062b9fbb3b
