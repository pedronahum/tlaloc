# TwIL-8B after LoRA SFT on Ripple-65B's trajectories (train run, then train merge), exported with
# NVFP4 MLP weights, FP8 attention weights and an FP8 KV cache (the TwIL-8B NVFP4 recipe of
# docs/work-log/twil-plan.md), otherwise served as twil-sft-bf16 is so the evaluations compare.
# CKPT_DIR is the merged checkpoint (relative to the example); MODEL_KEY still names the base for
# its tokenizer. One KEY=value per line.
MODEL_KEY=twil_8b
CKPT_DIR=build/data/train/merged
TRITON_MODEL=twil_sft_nvfp4
SERVED_NAME=twil-8b-sft-nvfp4
TEMPLATE=TWIL
# :maestro:exportHfServingArtifact properties. NVFP4 MLP and FP8 attention weights, quantized at
# export from the merged bf16 checkpoint; KV in FP8 (80 KiB per token). 4 sequences in a batch,
# contexts 8,192 and 16,384, 4,352 KV blocks of 16 tokens (69,632 tokens, 5.3 GiB), prompts
# prefilled 512 tokens per call.
EXPORT_PROPS=-PweightDType=bf16 -PweightQuant=nvfp4 -PkvDtype=fp8 -PmaxBatch=4 -PcontextLadder=8192,16384 -PblockSize=16 -PnumBlocks=4352 -PprefillChunk=512 -PprefillMaxBatch=2 -PcudaKernels=true
# :maestro:exportTritonModel properties.
TRITON_PROPS=-Pdecoupled=true -PmaxSequenceIdleMicros=600000000
# Share of GPU memory the PJRT client may use (KV pools and activations; weights are outside it).
MEMORY_FRACTION=0.3
# 1: XLA's deterministic ops and the CUDA kernels' order-independent sums. Off: with it a decode
# step of one sequence took 376 ms instead of 80 ms on the GB10.
DETERMINISTIC=0
# Live sequences the endpoint keeps for prefix reuse (--max-sequences). The model's 16 candidate
# sequences would keep finished conversations' KV until they idle out, and four conversations in
# flight then ran out of KV pages (HTTP 503 mid-generation); 4 is one per sequence in a batch.
ENDPOINT_MAX_SEQUENCES=4
# nvcr.io/nvidia/tritonserver:25.11-py3, pinned by digest; the backend is built in it too.
TRITON_IMAGE=nvcr.io/nvidia/tritonserver@sha256:871ef190093156e6f9b6371ac7663652e3d7d0f9b83729fe1f11af062b9fbb3b
