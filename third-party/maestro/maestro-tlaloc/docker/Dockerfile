# Tlaloc runtime container image (Layer 2.5.5 §0.4.249+).
#
# The image that Maestro's TlalocStepRuntime launches as a Kubernetes job.
# Holds Tlaloc's runtime jars (DTensor + StableHLO loader + SerializedBufferHandle
# reader + maestro-tlaloc TlalocRunner) and the vendored Maestro maestro-tlaloc
# module's compiled classes. Entry point is invoked via the shell command
# generated by TlalocEntrypointBuilder; not specified here.
#
# Multi-stage:
# - stage 1 (builder): pulls a JDK 21, runs the maestro-tlaloc Gradle build to
#   stage jars under build/docker/libs/.
# - stage 2 (final): JRE-only alpine; copies just the staged jars.
#
# Reproducibility: pin both base images by digest (eclipse-temurin's official
# tags are immutable for stable releases; we still pin to be safe). Gradle
# build is deterministic when run with --no-daemon --no-build-cache against
# the same source tree.
#
# Mirrors maestro-actus's docker/Dockerfile structure.

FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /build
COPY . /build
# Build the maestro-tlaloc jar + collect runtime dependencies under build/docker/libs/
RUN ./gradlew --no-daemon --no-build-cache \
      :maestro-tlaloc:assemble \
      :maestro-tlaloc:buildDockerContext

FROM eclipse-temurin:21-jre-alpine
LABEL org.opencontainers.image.title="tlaloc-runtime"
LABEL org.opencontainers.image.description="Tlaloc runtime container — TlalocRunner + Tlaloc :maestro jars for Maestro Kubernetes-step dispatch"
LABEL org.opencontainers.image.source="https://github.com/pedronahum/tlaloc"
LABEL org.opencontainers.image.licenses="Apache-2.0"
WORKDIR /app
COPY --from=builder /build/maestro-tlaloc/build/docker/libs/ /app/

# Maestro launches the entrypoint via TlalocEntrypointBuilder's generated shell
# command. No CMD/ENTRYPOINT here — Maestro fully controls the launch shape.
